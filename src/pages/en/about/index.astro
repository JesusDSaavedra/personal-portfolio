---
import { BorderBeam } from '@/components/magicui/border-beam'
import CardContactMe from '@/components/cards/card-contact-me.astro'
import MainLayout from '@/layouts/MainLayout.astro'
import { Image } from 'astro:assets'
---

<MainLayout>
  <div class="px-24 md:px-12 sm:px-0">
    <header class="flex flex-col items-center gap-8">
      <h2
        class="text-3xl mb-3 font-bold tracking-[-1.2px] bg-repeat bg-clip-text bg-100% bg-text-gradient"
        style="-webkit-text-fill-color:transparent"
      >
        About me!
      </h2>
      <div
        class="relative flex w-full justify-center rounded-2xl bg-neutral-300/20 dark:bg-neutral-400/10 backdrop-blur-[2px] border border-neutral-400/20 py-5"
      >
        <Image
          transition:name=`image profile.webp`
          loading="eager"
          alt="me"
          src="/img/profile.webp"
          class="rounded-2xl object-cover h-[300px] w-[300px]"
          width={300}
          height={300}
        />
        <BorderBeam size={300} borderWidth={1.9} duration={15} delay={0} />
      </div>
    </header>
    <div class="flex flex-col gap-5 mt-14 mb-2">
      <div class="flex flex-col gap-3 dark:text-zinc-300 text-zinc-600">
        <span>
          Full Stack Developer with 4 years of experience building high-impact web and mobile
          applications, specialized in the fintech sector. My stack ranges from modern interfaces
          with React, Vue, and Flutter, to robust backend architectures with Node.js and Docker,
          allowing me to design complete end-to-end solutions.
        </span>
        <span>
          I've worked on challenging projects ranging from digital banking suites to card control
          systems for thousands of users, always focused on quality, scalability, and user
          experience. Currently, I'm exploring the potential of AI agents to optimize development
          processes and smarter architectures, in addition to deepening my expertise in Flutter to
          create high-performance native mobile experiences.
        </span>
        <span>
          I enjoy working both in teams and autonomously, and my ability to communicate complex
          technical ideas has allowed me to lead projects and collaborate effectively with
          multidisciplinary teams. I actively contribute to open source projects like
          HacktoberfestES to keep myself in constant learning.
        </span>
        <span>
          In my free time, you'll find me participating in hackathons, exploring emerging
          frameworks, and staying active at the gym, because the best way to learn is by building
          and creating good habits.
        </span>
      </div>
      <div>
        <div class="mb-5">
          <span class="font-bold text-white/65">INTERACTIONS AND MENTIONS</span>
        </div>
        <div class="flex flex-col gap-3">
          <Image
            loading="eager"
            alt="me"
            src="/img/mention-1.jpg"
            class="rounded-2xl object-cover h-[] w-[600px]"
            width={1212}
            height={1260}
          />
          <Image
            loading="eager"
            alt="me"
            src="/img/mention-2.jpg"
            class="rounded-2xl object-cover h-[] w-[600px]"
            width={1212}
            height={1260}
          />
        </div>
      </div>
    </div>
    <div>
      <CardContactMe title="Contact with me!" />
    </div>
  </div>
</MainLayout>

<style></style>

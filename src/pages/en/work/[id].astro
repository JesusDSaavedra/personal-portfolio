---
import { Image } from 'astro:assets'
import MainLayout from '@/layouts/MainLayout.astro'
import CardTech from '@/components/marquee/card-tech.astro'
import Timeline from '@/components/timeline.astro'
import { projects } from '@/content/projects'
import { technologies } from '@/content/technologies'
import { MarqueeImages } from '@/components/marquee/marquee-images'
import { Bookmark } from '@/icons/bookmark.icon'
import Grille from '@/icons/grille.astro'

const lang: 'es' | 'en' = (Astro.currentLocale as 'en' | 'es') ?? 'en'

const { id } = Astro.params

const project = projects.find((project) => project.id === id)
const filteredTechnologies = project?.['stack-tech'].map((techName) => {
  return technologies[techName]
})
---

<MainLayout>
  <div class="relative p-4">
    <div class="absolute top-0 left-0 ml-14 md:ml-4">
      <a class="ml-14" href=`${lang === 'es' ? '/work' : '/en/work'}`>
        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 42 42"
          ><path
            fill="#999999"
            fill-rule="evenodd"
            d="M31 38.32L13.391 21L31 3.68L28.279 1L8 21.01L28.279 41z"></path></svg
        >
      </a>
    </div>
    <div class="flex gap-7 justify-center">
      <div class="flex flex-col items-center max-w-[650px]">
        <header class="flex flex-col gap-4 w-[650px] md:w-full">
          <div class="flex gap-4 items-start justify-center sm:flex-col">
            {
              project?.logo && (
                <Image
                  src={`/img/${project?.logo}`}
                  alt="logo"
                  width={30}
                  height={30}
                  class="w-[60px] h-[60px] rounded-md"
                />
              )
            }
            <div class="flex flex-col items-start">
              <h4
                class="text-xl font-semibold bg-repeat bg-clip-text bg-100% bg-text-gradient"
                transition:name={`company-name-${project?.id}`}
              >
                {project?.[`company-name`] || '-'}
              </h4>
              <h3 class="text-lg font-medium" transition:name={`title-${project?.id}`}>
                {project?.['title-en']}
              </h3>
            </div>
          </div>
          <div class="flex justify-center">
            <span class="text-center" transition:name={`description-${project?.id}`}>
              {project?.[`description-en`]}
            </span>
          </div>
          <span
            class="text-center font-semibold text-lg text-dark dark:text-[var(--white-text)] mt-10"
          >
            Stack of technologies used
          </span>
          <div class="flex md:flex-wrap justify-center gap-4">
            {
              filteredTechnologies?.map((technologie) => (
                <CardTech Icon={technologie.Icon} title={technologie.title} padding={0} />
              ))
            }
          </div>
        </header>

        <div class="flex justify-center items-center mt-12 mb-12">
          <Grille className="opacity-20 scale-y-[1] scale-x-[-1]" />
          <span class="w-max flex h-min">
            <Image
              loading="eager"
              class="dark:invert mx-6"
              alt={'dots'}
              src="/img/three-dots.svg"
              width="35"
              height="35"
            />
          </span>
          <Grille className="opacity-20 " />
        </div>

        <!-- Main Impact Section -->
        <section
          class="w-full max-w-[650px] mb-12 flex justify-center flex-col items-center"
          aria-labelledby="main-impact-heading"
        >
          <header class="mb-12 w-[100%]">
            <h3 class="text-xl font-semibold mb-6">Main Impact</h3>
            <p class="text-base leading-7 font-normal">
              {project?.['main-impact-en']}
            </p>
          </header>

          <div class="space-y-6">
            <h3 class="text-lg font-semibold flex items-center gap-3">Work Highlights</h3>
            <ul class="space-y-3" role="list">
              {
                project?.['work-highlights-en']?.map((highlight, index) => (
                  <li class="group flex items-start gap-4 p-4 " role="listitem">
                    <div class="flex-shrink-0 mt-1 group-hover:scale-110 transition-transform duration-200">
                      <Bookmark width={18} height={18} aria-hidden="true" />
                    </div>
                    <p class="text-base  leading-7 font-normal flex-1">{highlight}</p>
                  </li>
                ))
              }
            </ul>
          </div>
        </section>

        <div>
          <MarqueeImages images={project?.images} client:only />
        </div>
        {
          project?.timeline && (
            <div class="my-10">
              <div class="flex flex-col items-center">
                <Timeline
                  timelines={project?.timeline}
                  width={600}
                  widthImg={650}
                  heidthImg={350}
                />
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</MainLayout>

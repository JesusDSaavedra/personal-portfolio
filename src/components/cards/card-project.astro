---
import type { Project } from '../../content/projects'
import { technologies } from '@/content/technologies'
import { Image } from 'astro:assets'

interface Props {
  project: Project
  isPageWork: boolean
}

const { project } = Astro.props
const lang: 'es' | 'en' = (Astro.currentLocale as 'en' | 'es') ?? 'en'
const {
  [`title-${lang}` as 'title-en' | 'title-es']: title,
  [`description-${lang}` as 'description-en' | 'description-es']: description
} = project
---

<article
  class="relative rounded-3xl overflow-hidden flex gap-4 flex-col group transition-[border] duration-500 dark:bg-neutral-400/10 backdrop-blur-[2px] border border-neutral-400/20"
>
  <a href={`${lang === 'en' ? `/en/work/${project.id}` : `/work/${project.id}`}`}>
    <div class="bg-noise relative">
      <header
        class="absolute w-full z-10 top-4 px-3 inset-x-0 mx-auto flex items-center justify-end"
      >
        <div
          class="px-2 py-1 w-fit text-xs rounded-md bg-slate-50 dark:bg-[rgb(26,26,26)] text-accent-7 font-semibold"
          transition:name={`company-name-${project?.id}`}
        >
          {project['company-name']}
        </div>
      </header>
      <Image
        transition:name={project.image}
        alt=`${project.image}`
        width={350}
        height={350}
        class="w-full object-cover bg-gray-100 aspect-video group-hover:grayscale-0 opacity-80 group-hover:scale-105 transition-all duration-300 rounded-t-3xl"
        style="color:transparent;mask-image:linear-gradient(to bottom, black, transparent)"
        src={`/img/${project.image}`}
      />
      <footer class="absolute pl-3 z-50 inset-x-0 w-full top-24 flex justify-end items-center">
        <div class="flex -space-x-10 contrast-125">
          {
            project['stack-tech'].map((technologie, index) => {
              const currentTech = technologies[technologie]
              const { Icon } = currentTech
              return (
                <span
                  class="aspect-square bg-accent-2 overflow-hidden rounded-full scale-[0.44] bg-[rgba(221,221,221,0.78)] dark:bg-[rgba(53,53,53,0.81)] p-2 border-2 border-white/20"
                  style={`z-index:${index}`}
                >
                  <Icon />
                </span>
              )
            })
          }
        </div>
      </footer>
    </div>
    <div class="p-4 grid gap-4">
      <h2
        class="capitalize text-accent-7 group-hover:text-primary"
        transition:name={`title-${project?.id}`}
      >
        {title}
      </h2>
      <p
        class="text-sm leading-6 text-left text-dark/80 dark:text-white/60"
        transition:name={`description-${project?.id}`}
      >
        {description}
      </p>
    </div>
  </a>
</article>

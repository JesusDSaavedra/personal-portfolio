{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components": ["src/components/*"],
      "@/lib": ["src/lib/*"],
      "@/icons": ["src/icons/*"],
      "@/layouts": ["src/layouts/*"],
      "@/content": ["src/content/*"]
    }
  }
}
